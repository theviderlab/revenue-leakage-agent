# Any OpenAI-compatible endpoint. Copy model IDs exactly from the provider's catalog.
LLM_MODEL=anthropic/claude-sonnet-5.5
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# mock serves a scripted conversation without the LLM; an environment variable
# or `make dev AGENT_BACKEND=mock` overrides it per process.
AGENT_BACKEND=real
